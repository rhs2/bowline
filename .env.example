# =============================================================================
# Bowline: environment configuration
#
# Copy this file to `.env` for local development. Every service reads the
# variables it needs from the environment; nothing is read from files at runtime.
# In production the same names are injected from AWS Secrets Manager and the ECS
# task definition (see infra/terraform/modules/ecs).
#
# Secrets in this file are DEVELOPMENT placeholders. Never reuse them anywhere.
# =============================================================================

# ---- Database (PostgreSQL 16) ----------------------------------------------
# The single system of record for every service. The API connects as the
# read/write application role; billing and analytics use the read-only role;
# the notify worker uses a role that can only touch the notifications table.
# Local: `docker compose up -d postgres` creates the database and all three roles
# (see db/init/roles.sql). Migrations live in db/migrations and are applied by the
# API on start (or `make migrate`).
DATABASE_URL=postgres://bowline_app:bowline_app_dev@localhost:5432/bowline
DATABASE_URL_RO=postgres://bowline_ro:bowline_ro_dev@localhost:5432/bowline
DATABASE_URL_NOTIFY=postgres://bowline_notify:bowline_notify_dev@localhost:5432/bowline
DATABASE_MAX_CONNECTIONS=20
# Set to 1 to have the API refuse to start if migrations are pending instead of
# applying them (production posture: migrations run as a separate deploy step).
DATABASE_MIGRATE_ON_START=1

# ---- Redis 7 (principal cache, rate limiting, login lockout counters) -------
REDIS_URL=redis://localhost:6379/0

# ---- API (Rust, Axum) -------------------------------------------------------
API_BIND=0.0.0.0:8080
API_PUBLIC_URL=http://localhost:8080
# Origins allowed by CORS (comma separated). The web app origin goes here.
API_CORS_ORIGINS=http://localhost:3000
# JWT signing secret for access tokens: at least 32 random bytes, base64 or hex.
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_ISSUER=bowline
ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days, rotated on every use
# Login protection
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_PER_MINUTE=300             # per user (per IP for anonymous routes)
# Business thresholds
INVOICE_APPROVAL_THRESHOLD=50000      # invoices at or above this need invoices:approve
# Internal service endpoints the API calls
BILLING_URL=http://localhost:8081
ANALYTICS_URL=http://localhost:8082
# Shared secret the API sends as `X-Internal-Token` to billing and analytics
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me
# Logging: `json` in production, `pretty` for a terminal
LOG_FORMAT=pretty
RUST_LOG=info,bowline_api=debug,sqlx=warn

# ---- Object storage (S3 in production, MinIO locally) -----------------------
# Employee documents, shipment documents and rendered invoice PDFs. The API only
# issues presigned URLs; bytes never pass through it.
S3_ENDPOINT=http://localhost:9000      # leave empty for real AWS S3
S3_REGION=us-east-1
S3_BUCKET_DOCUMENTS=bowline-documents
S3_BUCKET_PDFS=bowline-pdfs
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=1                  # required for MinIO, 0 for AWS
PRESIGN_TTL_SECONDS=900

# ---- Email (notify worker, Go) ---------------------------------------------
# Local: Mailpit catches everything at http://localhost:8025.
# Production: Amazon SES SMTP credentials from Secrets Manager.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=0
MAIL_FROM="Bowline <no-reply@bowline.example>"
NOTIFY_POLL_INTERVAL_MS=2000
NOTIFY_BATCH_SIZE=50
NOTIFY_MAX_ATTEMPTS=8
NOTIFY_METRICS_BIND=0.0.0.0:9101

# ---- Billing service (Java, Spring Boot) -----------------------------------
BILLING_BIND_PORT=8081
BILLING_DATABASE_URL=jdbc:postgresql://localhost:5432/bowline
BILLING_DATABASE_USER=bowline_ro
BILLING_DATABASE_PASSWORD=bowline_ro_dev
BILLING_PDF_OUTPUT=s3                  # s3 | local (writes to ./billing/out for tests)
BILLING_COMPANY_NAME="Bowline Logistics"
BILLING_COMPANY_ADDRESS="1 Harbour Way, Port City"

# ---- Analytics service (Python, FastAPI) -----------------------------------
ANALYTICS_BIND_PORT=8082
ANALYTICS_DATABASE_URL=postgresql://bowline_ro:bowline_ro_dev@localhost:5432/bowline
ANALYTICS_MODEL_PATH=./analytics/models/delay_risk.joblib

# ---- Web app (Next.js) -----------------------------------------------------
# Server-side base URL for the API (inside Docker: http://api:8080)
API_INTERNAL_URL=http://localhost:8080
# Browser-facing base URL for the API
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=Bowline

# ---- Seed data (development only) ------------------------------------------
# `make seed` creates the 260-person company. Every seeded user gets this
# password and must change it on first login unless SEED_SKIP_PASSWORD_CHANGE=1.
SEED_PASSWORD=Bowline!2026
SEED_SKIP_PASSWORD_CHANGE=1
SEED_RANDOM_SEED=42

# ---- AWS (deploy workflow and Terraform only; not read by the services) ----
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
TF_VAR_environment=prod
TF_VAR_domain_name=bowline.example
